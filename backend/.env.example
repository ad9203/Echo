PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/notes_app
JWT_SECRET=super_secret_jwt_key_notes_app_2026
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud-Friendly Email Provider (Recommended for Render / Cloud Hosts - Port 443 HTTPS)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER=your_verified_sender_email@gmail.com
# Or Resend:
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM=Echo AI Notes <onboarding@resend.dev>

# Standard Nodemailer SMTP Configuration (Works locally or on servers allowing outbound ports 465/587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Echo AI Notes <your_email@gmail.com>
